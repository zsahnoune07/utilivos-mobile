# Copy to a local env file (e.g. `.env.build`) and fill in values. Files matching `.env.*`
# are gitignored except this example — never commit real secrets.
#
# Flutter reads these at **compile time** via `String.fromEnvironment` in
# `lib/core/config/app_config.dart`. A plain `.env` file is **not** read by the
# Dart VM at runtime. To build from env, use:
#
#   UTILIVOS_BUILD_ENV_FILE=.env.build tool/flutter_build_from_env.sh build apk --release
#
# Or pass the env file as the first argument (paths relative to repo root work):
#
#   tool/flutter_build_from_env.sh .env.staging build ios --release
#
# Optional leading `flutter` is accepted:
#
#   tool/flutter_build_from_env.sh .env.build flutter build apk --release
#
# ---------------------------------------------------------------------------
# Build-time file secrets (read by `tool/flutter_build_from_env.sh` only)
# ---------------------------------------------------------------------------
# Put PEM/text secrets **outside** the repo (e.g. `~/.secrets/`) and point to
# them here. The script reads the file contents and passes them as
# `--dart-define` (single line; newlines stripped). The app never opens paths
# at runtime — only inlined string values exist in the binary.
# MOBILE_CLIENT_SHARED_SECRET_FILE=/absolute/path/to/mobile_shared.txt
# MOBILE_CLIENT_SIGNATURE_SECRET_FILE=/absolute/path/to/mobile_signature.txt
#
# If a *_FILE is set and the file exists, it **overrides** the inline
# MOBILE_CLIENT_* value from this file for that build.
#
# Does `.env` hold the secret text or a path? — With *_FILE lines, only the
# **path** goes in `.env`; the script reads the file when you run a build. With
# no *_FILE, you put the **literal secret string** on MOBILE_CLIENT_* lines (still
# gitignored). The compiled app never reads paths; it only gets inlined strings.
#
# utilivos-api is different: `MOBILE_CLIENT_*_FILE` there is read by the **Go
# server at runtime** from mounted secrets. Mobile and API file layouts are
# independent; use key files on the API as you prefer.

# ---------------------------------------------------------------------------
# Required / common (defaults in Dart apply when unset — see app_config.dart)
# ---------------------------------------------------------------------------
APP_NAME=Utilivos
API_BASE_URL=http://10.0.2.2:8080
ANDROID_PACKAGE_NAME=com.utilivos.app

# ---------------------------------------------------------------------------
# Google Play billing / product ids
# ---------------------------------------------------------------------------
PREMIUM_ONE_TIME_PRODUCT_ID=utilivos_pro_one_time
PREMIUM_SUBSCRIPTION_PRODUCT_ID=utilivos_pro_subscription
PREMIUM_SUBSCRIPTION_MONTHLY_PRODUCT_ID=
PREMIUM_SUBSCRIPTION_ANNUAL_PRODUCT_ID=

# ---------------------------------------------------------------------------
# Security: bundle signing root (PEM public key, single line or empty)
# ---------------------------------------------------------------------------
PINNED_SIGNING_ROOT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Optional: local tool bundle seed for offline runtime testing
# ---------------------------------------------------------------------------
LOCAL_TOOL_BUNDLE_PATH=
LOCAL_TOOL_BUNDLE_SLUG=
LOCAL_TOOL_BUNDLE_VERSION=

# ---------------------------------------------------------------------------
# Optional: future tool report endpoint; App Store id for update links
# ---------------------------------------------------------------------------
TOOL_REPORT_SUBMIT_URL=
IOS_APP_STORE_ID=

# ---------------------------------------------------------------------------
# API client gate (must match utilivos-api MOBILE_CLIENT_* when gate is on)
# Omit both to disable signed headers in the app. Min 32 chars each on server.
# ---------------------------------------------------------------------------
MOBILE_CLIENT_SHARED_SECRET=
MOBILE_CLIENT_SIGNATURE_SECRET=
